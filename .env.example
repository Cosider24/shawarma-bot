# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
BOT_TOKEN=
MANAGER_IDS=123456789

# simulator = учебный имитатор (без провайдера); yookassa = тестовая ЮKassa через Telegram
PAYMENT_MODE=simulator
# Токен платёжного провайдера из @BotFather -> Payments (нужен при PAYMENT_MODE=yookassa)
PROVIDER_TOKEN=
# shopId и секретный ключ ТЕСТОВОГО магазина ЮKassa (нужны для возвратов через API)
YK_SHOP_ID=
YK_SECRET_KEY=

# Публичный HTTPS-адрес Mini App (ngrok / cloudflared), без слэша на конце
WEBAPP_URL=
WEB_HOST=127.0.0.1
WEB_PORT=8080
INITDATA_MAX_AGE=3600
SHOP_DB=shop.db
RESERVATION_SECONDS=120
WORKER_INTERVAL=5
# Точки аварий доступны только из отдельного набора tests.acceptance, в обычном запуске 0.
SHOP_TEST_MODE=0
AUTO_TUNNEL=1
